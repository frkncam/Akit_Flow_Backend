# .env.prod.example — prod ortam degiskenleri SABLONU
# Bu dosya repoya girer (deger YOK, sadece anahtar isimleri).
# Gercek dosya: sunucuda /opt/muhur/.env.prod (git-ignored, guclu parolalarla).
# Uret:  openssl rand -base64 18 | tr -d '/+=' | head -c 24

# PostgreSQL
DB_NAME=akitflow
DB_USERNAME=akitflow
DB_PASSWORD=__DEGISTIR__

# RabbitMQ
RABBITMQ_USERNAME=akitflow
RABBITMQ_PASSWORD=__DEGISTIR__

# MinIO (ilk acilista default; sonra sertlestirilecek)
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# Groq LLM (ai-service) — https://console.groq.com/keys
GROQ_API_KEY=__DEGISTIR__
