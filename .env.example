# Mühür Environment Variables
# Copy this file to .env and fill in values for your environment.
# .env is git-ignored — never commit real credentials.

# PostgreSQL
DB_USERNAME=akitflow
DB_PASSWORD=akitflow

# RabbitMQ
RABBITMQ_USERNAME=guest
RABBITMQ_PASSWORD=guest

# MinIO
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin

# JWT
AUTH_PRIVATE_KEY_PATH=classpath:keys/private.pem
AUTH_PUBLIC_KEY_PATH=classpath:keys/public.pem
