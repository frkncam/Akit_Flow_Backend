    {
      "name": "Templates",
      "description": "Template-service (port 8086) — sözleşme şablonları. Eski /api/v1/contract-templates path'leri /api/v1/templates olarak güncellendi.",
      "item": [
        {
          "name": "System Variables (Public)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/templates/system-variables", "host": ["{{baseUrl}}"], "path": ["api","v1","templates","system-variables"] },
            "description": "Template render ederken kullanılabilecek sistem değişkenlerini listeler (contract.title, contract.description, vb.)."
          }
        },
        {
          "name": "Create Template",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/templates", "host": ["{{baseUrl}}"], "path": ["api","v1","templates"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Vekalet Sözleşmesi\",\n  \"description\": \"Standart vekaletname şablonu\",\n  \"category\": \"SERVICE\",\n  \"bodyHtml\": \"<!DOCTYPE html><html><head><meta charset='UTF-8'><style>body{font-family:Arial,sans-serif;padding:40px;}h1{text-align:center;}table{width:100%;margin-top:20px;border-collapse:collapse;}th,td{border:1px solid #ccc;padding:8px;text-align:left;}</style></head><body><h1>VEKALETNAME</h1><p><strong>Sözleşme Başlığı:</strong> {{contract.title}}</p><p><strong>Açıklama:</strong> {{contract.description}}</p><p><strong>Başlangıç:</strong> {{contract.startDate}} | <strong>Bitiş:</strong> {{contract.endDate}}</p><p><strong>Değer:</strong> {{contract.value}} {{contract.currency}}</p><h3>Taraflar</h3><table><thead><tr><th>İsim</th><th>Rol</th><th>E-posta</th></tr></thead><tbody>{{#contract.parties}}<tr><td>{{name}}</td><td>{{role}}</td><td>{{email}}</td></tr>{{/contract.parties}}</tbody></table><p style='margin-top:40px;text-align:right;color:#888;font-size:12px;'>Üretildi: {{generatedAt}}</p></body></html>\",\n  \"variables\": []\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const j = pm.response.json();",
                  "  pm.collectionVariables.set('templateId', j.id);",
                  "  pm.test('templateId set', () => pm.expect(j.id).to.be.a('number'));",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "List Templates",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/api/v1/templates",
              "host": ["{{baseUrl}}"],
              "path": ["api","v1","templates"]
            },
            "description": "Opsiyonel ?category=NDA|EMPLOYMENT|SERVICE|RENTAL|OTHER filtresiyle kullanılabilir."
          }
        },
        {
          "name": "Get Template By Id",
          "request": {
            "method": "GET",
            "header": [],
            "url": { "raw": "{{baseUrl}}/api/v1/templates/{{templateId}}", "host": ["{{baseUrl}}"], "path": ["api","v1","templates","{{templateId}}"] }
