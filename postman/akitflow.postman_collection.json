{
  "info": {
    "name": "AkitFlow - Backend APIs",
    "description": "AkitFlow tüm backend servisleri için Postman koleksiyonu. Tüm istekler api-gateway (8080) üzerinden gider. Gateway JWT'yi doğrular, X-User-Id/X-Org-Id header'larını downstream servislere geçirir. Direkt servise erişim için authDirectUrl/contractDirectUrl/notificationDirectUrl variable'ları da var (debug amaçlı). Register/Login/Refresh sonrası token'lar; Contract Create sonrası contractId; File Upload sonrası fileId otomatik kaydedilir.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "a1b2c3d4-akitflow-backend-0001"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string", "description": "Gateway entry point — tüm public istekler buradan" },
    { "key": "authDirectUrl", "value": "http://localhost:8081", "type": "string", "description": "Auth servise direkt erişim (debug; JWKS endpoint için)" },
    { "key": "contractDirectUrl", "value": "http://localhost:8083", "type": "string", "description": "Contract servise direkt erişim (debug)" },
    { "key": "notificationDirectUrl", "value": "http://localhost:8082", "type": "string", "description": "Notification servise direkt erişim (debug)" },
    { "key": "eurekaUrl", "value": "http://localhost:8761", "type": "string", "description": "Eureka dashboard" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "refreshToken", "value": "", "type": "string" },
    { "key": "inviteToken", "value": "", "type": "string" },
    { "key": "contractId", "value": "", "type": "string" },
    { "key": "fileId", "value": "", "type": "string" },
    { "key": "templateId", "value": "", "type": "string" },
    { "key": "signatureToken", "value": "", "type": "string", "description": "send-for-signature response'undan ilk signer'ın token'ı otomatik set edilir" },
    { "key": "signatureToken2", "value": "", "type": "string", "description": "İkinci signer'ın token'ı (varsa)" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [
