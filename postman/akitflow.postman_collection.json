{
  "info": {
    "name": "Mühür - Backend APIs",
    "description": "Mühür tüm backend servisleri için Postman koleksiyonu. Tüm istekler api-gateway (8080) üzerinden gider. Gateway JWT'yi doğrular, X-User-Id/X-Org-Id header'larını downstream servislere geçirir. Servisler: auth(8081), notification(8082), contract(8083), template(8086), signature(8087), workflow(8088), audit(8089).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "a1b2c3d4-muhur-backend-0002"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080", "type": "string", "description": "Gateway entry point" },
    { "key": "authDirectUrl", "value": "http://localhost:8081", "type": "string", "description": "Auth servise direkt erişim (debug)" },
    { "key": "contractDirectUrl", "value": "http://localhost:8083", "type": "string", "description": "Contract servise direkt erişim (debug)" },
    { "key": "notificationDirectUrl", "value": "http://localhost:8082", "type": "string", "description": "Notification servise direkt erişim (debug)" },
    { "key": "templateDirectUrl", "value": "http://localhost:8086", "type": "string", "description": "Template servise direkt erişim (debug)" },
    { "key": "signatureDirectUrl", "value": "http://localhost:8087", "type": "string", "description": "Signature servise direkt erişim (debug)" },
    { "key": "eurekaUrl", "value": "http://localhost:8761", "type": "string", "description": "Eureka dashboard" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "refreshToken", "value": "", "type": "string" },
    { "key": "inviteToken", "value": "", "type": "string" },
    { "key": "contractId", "value": "", "type": "string" },
    { "key": "fileId", "value": "", "type": "string" },
    { "key": "templateId", "value": "", "type": "string" },
    { "key": "signatureToken", "value": "", "type": "string", "description": "Mailpit üzerinden signer link'inden manuel kopyalanır" },
    { "key": "workflowDirectUrl", "value": "http://localhost:8088", "type": "string", "description": "Workflow servise direkt erişim (debug)" },
    { "key": "stepId", "value": "", "type": "string" },
    { "key": "auditDirectUrl", "value": "http://localhost:8089", "type": "string", "description": "Audit servise direkt erişim (debug)" },
    { "key": "auditEventId", "value": "", "type": "string", "description": "Search Audit Events çağrısından otomatik set edilir" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register (Organization + Owner)",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/register", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","register"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user\": {\n    \"email\": \"furkan@demirhukuk.com\",\n    \"firstName\": \"Furkan\",\n    \"lastName\": \"Demir\",\n    \"organization\": {\n      \"name\": \"Demir Hukuk Bürosu\"\n    }\n  },\n  \"password\": \"Sifre123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const j = pm.response.json();",
                  "  pm.collectionVariables.set('accessToken', j.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', j.refreshToken);",
                  "  pm.test('tokens set', () => {",
                  "    pm.expect(j.accessToken).to.be.a('string');",
                  "  });",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/login", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","login"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"furkan@demirhukuk.com\",\n  \"password\": \"Sifre123!\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const j = pm.response.json();",
                  "  pm.collectionVariables.set('accessToken', j.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', j.refreshToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Refresh Token",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "url": { "raw": "{{baseUrl}}/api/v1/auth/refresh", "host": ["{{baseUrl}}"], "path": ["api","v1","auth","refresh"] },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const j = pm.response.json();",
                  "  pm.collectionVariables.set('accessToken', j.accessToken);",
                  "  pm.collectionVariables.set('refreshToken', j.refreshToken);",
                  "}"
                ]
              }
            }
          ]
        },
        {
          "name": "Logout",
          "request": {
            "auth": { "type": "noauth" },
