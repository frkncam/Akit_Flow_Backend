          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  const j = pm.response.json();",
                  "  if (j.steps && j.steps.length > 0) {",
                  "    pm.collectionVariables.set('stepId', j.steps[0].id);",
                  "    pm.test('stepId set', () => pm.expect(j.steps[0].id).to.be.a('number'));",
                  "  }",
                  "}"
                ]
              }
            }
          ]
